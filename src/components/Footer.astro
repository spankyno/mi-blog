---
const year = new Date().getFullYear();
const db = Astro.locals.runtime?.env?.DB;
let totalPosts = 0;

if (db) {
  const result = await db.prepare(`SELECT COUNT(*) as n FROM posts WHERE draft != 1`).first();
  totalPosts = (result as any)?.n ?? 0;
}
---
<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="footer-name">Aitor Sánchez Gutiérrez</span>
        {totalPosts > 0 && (
          <span class="footer-count">{totalPosts} artículos publicados</span>
        )}
      </div>
      <nav class="footer-nav" aria-label="Enlaces del pie de página">
        <a href="/blog">Blog</a>
        <a href="/rss.xml" title="Feed RSS" aria-label="Feed RSS — suscribirse">RSS</a>
        <a href="https://aitorhub.vercel.app/" target="_blank" rel="noopener noreferrer">Aitor's Hub</a>
        <a href="https://aitorsanchez.pages.dev/contacto/" target="_blank" rel="noopener noreferrer">Contacto</a>
        <a href="/privacidad">Privacidad</a>
      </nav>
    </div>

    <div class="footer-stack">
      <span class="stack-label">Hecho con</span>
      <div class="stack-badges">
        <!-- Fila 1 -->
        <div class="badge-row">
          <div class="badge">
            <svg viewBox="0 0 256 366" width="13" height="13" aria-hidden="true"><path fill="#FF5D01" d="M182.022 9.147c2.982 3.702 4.447 8.816 7.377 19.044l43.73 160.238a250.26 250.26 0 0 0-72.9-24.04l-28.64-97.04a3.703 3.703 0 0 0-7.117.003l-28.468 96.973a250.403 250.403 0 0 0-72.862 24.054L66.87 28.19c2.93-10.228 4.395-15.342 7.377-19.044a24.88 24.88 0 0 1 10.539-7.891C88.738 0 94.05 0 104.674 0h46.662c10.624 0 15.935 0 21.888 1.255a24.88 24.88 0 0 1 10.539 7.891h-.741Z"/><path fill="#FF5D01" d="M189.742 199.217c-5.52 4.721-16.509 7.942-29.055 7.942-15.454 0-28.387-4.803-31.768-11.26-.243-.467-.408-.958-.493-1.464a44.32 44.32 0 0 1-.394-5.987V185.92h-1.044v2.528c0 2.072-.133 4.106-.394 5.987-.085.506-.25.997-.493 1.464-3.381 6.457-16.314 11.26-31.768 11.26-12.546 0-23.535-3.221-29.055-7.942C35.467 214.168 0 232.945 0 254.5c0 30.928 57.308 56 128 56s128-25.072 128-56c0-21.555-35.467-40.332-66.258-55.283Z"/></svg>
