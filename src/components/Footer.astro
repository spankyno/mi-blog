            <span>TypeScript</span>
          </div>
          <div class="badge">
            <svg viewBox="0 0 256 256" width="13" height="13" aria-hidden="true"><rect width="256" height="256" rx="60" fill="#539E43"/><path fill="#fff" d="M119.878 52.339c4.818-8.319 17.424-8.319 22.243 0l72.155 124.723c4.818 8.319-1.205 18.718-11.121 18.718H58.844c-9.916 0-15.938-10.4-11.121-18.718z"/></svg>
            <span>Node.js</span>
          </div>
          <div class="badge">
            <svg viewBox="0 0 192 192" width="13" height="13" aria-hidden="true"><path fill="#F9AB00" d="M117 117V27c0-8.284 6.716-15 15-15s15 6.716 15 15v90c0 8.284-6.716 15-15 15s-15-6.716-15-15z"/><path fill="#E37400" d="M15 117V87c0-8.284 6.716-15 15-15s15 6.716 15 15v30c0 8.284-6.716 15-15 15s-15-6.716-15-15zM147 177a15 15 0 1 1 0-30 15 15 0 0 1 0 30zm-66 0a15 15 0 1 1 0-30 15 15 0 0 1 0 30z"/><path fill="#F9AB00" d="M66 117V57c0-8.284 6.716-15 15-15s15 6.716 15 15v60c0 8.284-6.716 15-15 15s-15-6.716-15-15z"/></svg>
            <span>Analytics</span>
          </div>
        </div>
        <!-- Fila 2 -->
        <div class="badge-row">
          <div class="badge">
            <svg viewBox="0 0 128 128" width="13" height="13" aria-hidden="true"><path fill="#E44D26" d="M19.037 113.876L9.032 1.661h109.936l-10.016 112.198-45.019 12.48z"/><path fill="#F16529" d="M64 116.8l36.378-10.086 8.559-95.878H64z"/><path fill="#EBEBEB" d="M64 52.455H45.788L44.53 38.361H64V24.599H29.489l.33 3.692 3.382 37.927H64zm0 35.743l-.061.017-15.327-4.14-.979-10.975H33.816l1.928 21.609 28.193 7.826.063-.017z"/><path fill="#fff" d="M63.952 52.455v13.762h16.947l-1.597 17.849-15.35 4.143v14.319l28.215-7.82.207-2.325 3.234-36.233.336-3.695zm0-27.856v13.762h33.244l.276-3.092.628-6.978.329-3.692z"/></svg>
            <span>HTML5</span>
          </div>
          <div class="badge">
            <svg viewBox="0 0 128 128" width="13" height="13" aria-hidden="true"><path fill="#181616" d="M64 5.103c-33.347 0-60.388 27.035-60.388 60.388 0 26.682 17.303 49.317 41.297 57.303 3.017.56 4.125-1.31 4.125-2.905 0-1.44-.056-6.197-.082-11.243-16.8 3.653-20.345-7.125-20.345-7.125-2.747-6.98-6.705-8.836-6.705-8.836-5.48-3.748.413-3.67.413-3.67 6.063.425 9.257 6.223 9.257 6.223 5.386 9.23 14.127 6.562 17.573 5.02.542-3.903 2.107-6.568 3.834-8.076-13.413-1.525-27.514-6.704-27.514-29.843 0-6.593 2.36-11.98 6.223-16.21-.628-1.52-2.695-7.662.584-15.98 0 0 5.07-1.623 16.61 6.19C53.7 35 58.867 34.327 64 34.304c5.13.023 10.3.694 15.127 2.033 11.526-7.813 16.59-6.19 16.59-6.19 3.287 8.317 1.22 14.46.593 15.98 3.872 4.23 6.215 9.617 6.215 16.21 0 23.194-14.127 28.3-27.574 29.796 2.167 1.874 4.097 5.55 4.097 11.183 0 8.08-.07 14.583-.07 16.572 0 1.607 1.088 3.49 4.148 2.897 23.98-7.994 41.263-30.622 41.263-57.294C124.388 32.14 97.35 5.104 64 5.104z"/></svg>
            <span>GitHub</span>
          </div>
          <div class="badge">
            <svg viewBox="0 0 256 256" width="13" height="13" aria-hidden="true"><rect width="256" height="256" rx="4" fill="#F26522"/><path fill="#fff" d="M68 64h120v24H68zm0 48h120v24H68zm0 48h80v24H68z"/></svg>
            <span>RSS</span>
          </div>
          <div class="badge">
            <svg viewBox="0 0 128 128" width="13" height="13" aria-hidden="true"><path fill="#000" d="M108 28H20a8 8 0 0 0-8 8v56a8 8 0 0 0 8 8h88a8 8 0 0 0 8-8V36a8 8 0 0 0-8-8zM48 84V56l16 16 16-16v28H92V44H80L64 60 48 44H36v40z"/></svg>
            <span>Markdown</span>
          </div>
          <div class="badge">
            <svg viewBox="0 0 128 128" width="13" height="13" aria-hidden="true"><path fill="#f7df1e" d="M2 2h124v124H2z"/><path d="M116.682 109.405c-2.387-1.986-14.888-7.211-17.248-8.545-2.36-1.334-3.944-.205-5.125 1.026-1.182 1.231-3.38 4.406-4.22 5.535-.84 1.129-1.786 1.285-3.246.566-1.46-.719-6.175-2.275-11.755-7.245-4.345-3.866-7.28-8.64-8.131-10.1-.851-1.46-.09-2.25.64-2.976.656-.659 1.46-1.718 2.19-2.577.73-.859.972-1.474.458-2.73-.514-1.256-4.611-11.116-6.317-15.22-1.663-3.994-3.352-3.453-4.611-3.517-1.193-.061-2.557-.073-3.921-.073-1.364 0-3.581.512-5.456 2.561-1.875 2.049-7.156 6.99-7.156 17.053s7.328 19.779 8.351 21.142c1.022 1.363 14.416 22.007 34.928 30.854 4.884 2.107 8.698 3.365 11.667 4.306 4.902 1.558 9.365 1.339 12.888.812 3.93-.587 12.101-4.946 13.802-9.726 1.701-4.78 1.701-8.876.84-9.729-.861-.853-2.248-1.365-4.635-3.353z" fill="#fff"/></svg>
            <span>JSON-LD</span>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <address class="footer-copy">
        © {year} Aitor Sánchez Gutiérrez — <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> + <a href="https://pages.cloudflare.com" target="_blank" rel="noopener noreferrer">Cloudflare Pages</a>
      </address>
    </div>
  </div>
  {/* Honeypot — invisible para humanos, visible en el HTML para crawlers */}
  <a href="/trap" aria-hidden="true" tabindex="-1" style="position:absolute;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none;">.</a>
</footer>

<style>
  footer {
    position: relative;
    margin-top: 6rem;
    padding: 2.5rem 1.5rem 2rem;
  }
  footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, transparent 0%, var(--color-border) 20%, var(--color-border) 80%, transparent 100%);
  }
  footer::after {
    content: '';
    position: absolute;
    top: -3rem;
    left: 0;
    right: 0;
    height: 3rem;
    background: linear-gradient(to bottom, transparent, rgba(229,229,224,0.15));
    pointer-events: none;
  }
  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .footer-brand { display: flex; flex-direction: column; gap: 0.2rem; }
  .footer-name { font-size: 0.9rem; font-weight: 500; color: var(--color-text); letter-spacing: -0.01em; }
  .footer-count { font-size: 0.75rem; color: var(--color-muted); }
  .footer-nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .footer-nav a {
    font-size: 0.82rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .footer-nav a:hover { color: var(--color-text); }
  .footer-nav a:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .footer-stack {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .stack-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-muted);
    font-weight: 500;
  }
  .stack-badges { display: flex; flex-direction: column; gap: 0.5rem; }
  .badge-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: 5px;
    border: 1px solid var(--color-border);
    background: #f9f9f7;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-text);
    white-space: nowrap;
  }
  html[data-theme='dark'] .badge {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
  }
  html[data-theme='dark'] .badge svg path[fill="#181616"],
  html[data-theme='dark'] .badge svg path[fill="#000"] {
    fill: #e5e5e5;
  }

  .footer-bottom { padding-top: 1rem; }
  .footer-copy { font-size: 0.78rem; color: var(--color-muted); font-style: normal; }
  .footer-copy a { color: var(--color-muted); text-decoration: underline; text-underline-offset: 3px; transition: color 0.2s; }
  .footer-copy a:hover { color: var(--color-text); }
  .footer-copy a:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
    border-radius: 3px;
  }

  @media (max-width: 560px) {
    .footer-top { flex-direction: column; align-items: flex-start; }
    .footer-nav { gap: 1rem; }
  }
</style>
