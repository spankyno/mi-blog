---
const nav = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog" },
  { label: "Aitor's Hub", href: "https://aitorhub.vercel.app/", external: true },
  { label: "Contacto", href: "/contacto" },
  { label: "Admin", href: "/panel" },
];
const current = Astro.url.pathname;
---
<a href="#main-content" class="skip-link">Saltar al contenido</a>
<header>
  <nav aria-label="Navegación principal">
    <ul class="nav-links">
      {nav.map(({ label, href, external }) => (
        <li>
          <a
            href={href}
            class={!external && (href === '/' ? current === '/' : current.startsWith(href)) ? 'active' : ''}
            aria-current={!external && (href === '/' ? current === '/' : current.startsWith(href)) ? 'page' : undefined}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >{label}</a>
        </li>
      ))}
    </ul>
    <button id="theme-toggle" aria-label="Activar modo oscuro" aria-pressed="false">
      <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
  </nav>
</header>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    
    // Prevent duplicate listeners if view transitions didn't replace the button properly
    const newBtn = btn.cloneNode(true);
    btn.parentNode?.replaceChild(newBtn, btn);
    
    // Sync aria-label and aria-pressed with current theme on load
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    newBtn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    newBtn.setAttribute('aria-label', isDark ? 'Activar modo claro' : 'Activar modo oscuro');

    newBtn.addEventListener('click', () => {
      const isDarkNow = document.documentElement.getAttribute('data-theme') === 'dark';
      if (isDarkNow) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
        newBtn.setAttribute('aria-pressed', 'false');
        newBtn.setAttribute('aria-label', 'Activar modo oscuro');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
        newBtn.setAttribute('aria-pressed', 'true');
        newBtn.setAttribute('aria-label', 'Activar modo claro');
      }
    });
  }
  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>

<style>
  header {
    position: sticky;
    top: 0;
    background: var(--color-glass, rgba(250, 250, 248, 0.75));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-links {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    transition: color 0.2s;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .nav-links a:hover, .nav-links a.active {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  #theme-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 50%;
    transition: background 0.2s, transform 0.2s;
  }
  #theme-toggle:hover {
    background: rgba(128, 128, 128, 0.1);
  }
  #theme-toggle:active {
    transform: scale(0.95);
  }
  :global(html[data-theme='dark']) .sun-icon { display: none; }
  :global(html:not([data-theme='dark'])) .moon-icon { display: none; }
  
  /* Skip link — visible solo con teclado */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    background: var(--color-text);
    color: var(--color-bg);
    padding: 0.5rem 1rem;
    border-radius: 0 0 6px 6px;
    font-size: 0.875rem;
    font-weight: 500;
    z-index: 200;
    transition: top 0.2s;
  }
  .skip-link:focus-visible {
    top: 0;
  }

  /* Focus visible global para navegación con teclado */
  :global(:focus-visible) {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
    border-radius: 3px;
  }
  :global(:focus:not(:focus-visible)) {
    outline: none;
  }

  /* Focus específico en links de nav */
  .nav-links a:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
    border-radius: 3px;
  }

  /* Focus en el botón de tema */
  #theme-toggle:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  @media (max-width: 600px) {
    .nav-links {
      gap: 1rem;
    }
  }
</style>
