---
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  pubDate?: string;
  canonical?: string;
  heroImage?: string;       // URL optimizada para preload (solo en posts)
  heroImageMobile?: string; // Versión 640px para srcset del preload
}

const SITE_URL = 'https://aitorsanchez.pages.dev';
const SITE_NAME = 'Aitor Sánchez Gutiérrez';
const AUTHOR_IMAGE = `${SITE_URL}/images/AitorSanchez.webp`;
const DEFAULT_DESC = 'Reflexiones sobre sociedad, tecnología y estilo de vida: desde la administración pública y la desinformación digital hasta la felicidad, el consumo, críticas sociales y relatos creativos.';
const DEFAULT_OG_IMAGE = `${SITE_URL}/images/foto-portada.webp`;

const author = {
  '@type': 'Person',
  name: SITE_NAME,
  url: SITE_URL,
  image: AUTHOR_IMAGE,
  sameAs: [
    'https://aitor-blog-contacto.vercel.app/',
    'https://aitorhub.vercel.app/',
  ],
};

const {
  title,
  description = DEFAULT_DESC,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  pubDate,
  canonical = `${SITE_URL}${Astro.url.pathname}`,
  heroImage,
  heroImageMobile,
} = Astro.props;

const fullTitle = title === SITE_NAME ? title : `${title} — ${SITE_NAME}`;
const isPanel = Astro.url.pathname.startsWith('/panel');

const jsonLd = ogType === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: {
        '@type': 'ImageObject',
        url: ogImage,
        width: 1200,
        height: 630,
        alt: fullTitle,
      },
      author,
      publisher: author,
      url: canonical,
      ...(pubDate ? { datePublished: pubDate } : {}),
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonical
      }
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: SITE_NAME,
      description: DEFAULT_DESC,
      url: SITE_URL,
      author,
    };

const personLd = ogType !== 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_NAME,
  url: SITE_URL,
  image: AUTHOR_IMAGE,
  description: DEFAULT_DESC,
  sameAs: [
    'https://aitor-blog-contacto.vercel.app/',
    'https://aitorhub.vercel.app/',
  ],
} : null;

const breadcrumbLd = ogType === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ]
} : null;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO básico -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="fK2gZcSYwHHPqDFWdIB5WD1eVONqa6kwIFqkRDRyX4g" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload hero image (solo en posts) — crítico para LCP -->
    {heroImage && (
      <link
        rel="preload"
        as="image"
        href={heroImage}
        imagesrcset={heroImageMobile ? `${heroImageMobile} 640w, ${heroImage} 1200w` : heroImage}
        imagesizes="(max-width: 640px) 640px, 1200px"
        fetchpriority="high"
      />
    )}

    <!-- DNS prefetch como fallback para navegadores sin preconnect -->
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="alternate" type="application/rss+xml" title="Aitor Sánchez Gutiérrez" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={ogType === 'article' ? title : description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content="es_ES" />
    {ogType === 'article' && pubDate && (
      <meta property="article:published_time" content={pubDate} />
    )}
    {ogType === 'article' && (
      <meta property="article:author" content={SITE_NAME} />
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={ogType === 'article' ? title : description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {breadcrumbLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    )}
    {personLd && (
      <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    )}

    <!-- View Transitions — solo fuera del panel -->
    {!isPanel && <ViewTransitions />}

    <!-- Google Analytics GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BGWJGKHK8V"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-BGWJGKHK8V');
      document.addEventListener('astro:page-load', () => {
        gtag('event', 'page_view', {
          page_location: window.location.href,
          page_title: document.title,
        });
      });
    </script>

    <!-- Preconnect a servicios externos -->
    <link rel="preconnect" href="https://res.cloudinary.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fuentes: media=print trick para carga no bloqueante -->
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,700;9..40,800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,700;9..40,800&display=swap" rel="stylesheet" />
    </noscript>

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
    </script>

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --font-display: 'DM Serif Display', serif;
        --font-body: 'DM Sans', sans-serif;
        --color-bg: #fafaf8;
        --color-text: #1a1a18;
        --color-muted: #6b6b67;
        --color-border: #e5e5e0;
        --color-accent: #1a1a18;
        --color-glass: rgba(250, 250, 248, 0.75);
        --max-width: 740px;
      }
      html[data-theme='dark'] {
        --color-bg: #121212;
        --color-text: #e5e5e5;
        --color-muted: #a1a1aa;
        --color-border: #27272a;
        --color-accent: #ffffff;
        --color-glass: rgba(18, 18, 18, 0.75);
      }
      body {
        font-family: var(--font-body);
        background: var(--color-bg);
        color: var(--color-text);
        font-size: 17px;
        line-height: 1.7;
        font-weight: 300;
      }
      a { color: inherit; text-decoration: none; -webkit-tap-highlight-color: transparent; }
      a:visited { color: inherit; }

      /* Target del skip link */
      main:target, main[id]:focus {
        outline: none;
      }

      /* Estilos Globales para contenido Markdown (.content) */
      .content {
        font-size: clamp(1rem, 2.5vw, 1.075rem);
        font-weight: 400;
        line-height: 1.85;
        letter-spacing: -0.01em;
      }
      .content p { margin-bottom: 1.75rem; max-width: 68ch; }
      .content h2 {
        font-family: var(--font-display);
        font-size: clamp(1.35rem, 3vw, 1.6rem);
        font-weight: 400;
        letter-spacing: -0.02em;
        line-height: 1.25;
        margin: 3rem 0 1.1rem;
        color: var(--color-text);
      }
      .content h3 {
        font-size: clamp(1.05rem, 2.5vw, 1.2rem);
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.35;
        margin: 2.25rem 0 0.85rem;
        color: var(--color-text);
      }
      .content strong,
      .content b { font-weight: 700; color: var(--color-text); }
      .content a {
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
        text-decoration-color: var(--color-border);
        transition: text-decoration-color 0.2s;
      }
      .content a:hover { text-decoration-color: var(--color-text); }
      .content ul, .content ol { padding-left: 1.6rem; margin-bottom: 1.75rem; max-width: 68ch; }
      .content li { margin-bottom: 0.5rem; line-height: 1.7; }
      .content blockquote {
        border-left: 3px solid var(--color-border);
        margin: 2rem 0;
        padding: 0.75rem 0 0.75rem 1.5rem;
        background: rgba(128, 128, 128, 0.05);
        border-radius: 0 6px 6px 0;
        color: var(--color-muted);
        font-style: italic;
        font-size: 1.05em;
      }
      .content pre {
        background: rgba(128, 128, 128, 0.08);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.1rem 1.4rem;
        overflow-x: auto;
        margin-bottom: 1.75rem;
        font-size: 0.875rem;
        line-height: 1.6;
      }
      .content code {
        font-size: 0.875em;
        background: rgba(128, 128, 128, 0.1);
        border: 1px solid var(--color-border);
        padding: 0.15em 0.45em;
        border-radius: 4px;
      }
      .content pre code { background: none; border: none; padding: 0; font-size: inherit; }
      .content img { max-width: 100%; border-radius: 8px; }
      .content hr { border: none; border-top: 1px solid var(--color-border); margin: 2.5rem 0; }
      
      @media (max-width: 480px) {
        .content { font-size: 1rem; letter-spacing: 0; }
        .content p, .content ul, .content ol { max-width: 100%; }
      }
    </style>
  </head>
  <body>
    <slot />

    <div id="aviso-privacidad" transition:persist>
      <p>Este sitio usa Google Analytics para medir el tráfico de forma anónima, y registra datos de acceso con fines de seguridad. No se usan cookies de publicidad.</p>
      <button onclick="document.getElementById('aviso-privacidad').style.display='none';localStorage.setItem('aviso-ok','1')">Entendido</button>
    </div>

    <script>
      function checkAviso() {
        if (localStorage.getItem('aviso-ok')) {
          const el = document.getElementById('aviso-privacidad');
          if (el) el.style.display = 'none';
        }
      }
      checkAviso();
      document.addEventListener('astro:page-load', checkAviso);
    </script>

    <style>
      #aviso-privacidad {
        position: fixed;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        width: min(92%, 680px);
        background: var(--color-text);
        color: var(--color-bg);
        padding: 1rem 1.25rem;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        font-size: 0.85rem;
        z-index: 999;
        box-shadow: 0 4px 24px rgba(0,0,0,0.18);
      }
      #aviso-privacidad p { flex: 1; line-height: 1.5; }
      #aviso-privacidad button {
        background: var(--color-bg);
        color: var(--color-text);
        border: none;
        padding: 0.45rem 1rem;
        border-radius: 5px;
        font-size: 0.82rem;
        font-family: var(--font-body);
        cursor: pointer;
        white-space: nowrap;
        font-weight: 500;
      }
    </style>
  </body>
</html>
