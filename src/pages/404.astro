---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const db = Astro.locals.runtime?.env?.DB;
let posts: any[] = [];

if (db) {
  const result = await db.prepare(
    `SELECT slug, title, pub_date FROM posts WHERE draft != 1 ORDER BY pub_date DESC LIMIT 5`
  ).all();
  posts = result.results ?? [];
}
---
<Base title="Página no encontrada — Aitor Sánchez Gutiérrez" description="La página que buscas no existe o ha sido movida.">
  <Header />
  <main>
    <div class="error-wrap">
      <span class="error-code">404</span>
      <h1>Página no encontrada</h1>
      <p class="error-msg">La página que buscas no existe, ha sido movida o la URL no es correcta.</p>

      <div class="error-actions">
        <a href="/" class="btn-primary">Ir a la home</a>
        <a href="/blog" class="btn-secondary">Ver el blog</a>
      </div>
    </div>

    {posts.length > 0 && (
      <div class="suggestions">
        <p class="suggestions-label">Quizás te interese</p>
        <ul>
          {posts.map((post: any) => (
            <li>
              <a href={`/blog/${post.slug}`}>
                <span class="post-title">{post.title}</span>
                <span class="post-date">{new Date(post.pub_date).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </main>
  <Footer />
</Base>

<style>
  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 5rem 1.5rem 4rem;
  }
  .error-wrap {
    text-align: center;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }
  .error-code {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(5rem, 15vw, 9rem);
    font-weight: 400;
    line-height: 1;
    color: var(--color-border);
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
    user-select: none;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }
  .error-msg {
    font-size: 0.95rem;
    color: var(--color-muted);
    max-width: 38ch;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }
  .error-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: var(--color-text);
    color: var(--color-bg);
    padding: 0.6rem 1.5rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .btn-primary:hover { opacity: 0.75; }
  .btn-secondary {
    background: transparent;
    color: var(--color-text);
    padding: 0.6rem 1.5rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: background 0.2s;
  }
  .btn-secondary:hover { background: var(--color-border); }

  .suggestions { max-width: 480px; margin: 0 auto; }
  .suggestions-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-muted);
    font-weight: 500;
    margin-bottom: 1rem;
  }
  .suggestions ul { list-style: none; }
  .suggestions li { border-top: 1px solid var(--color-border); }
  .suggestions li:last-child { border-bottom: 1px solid var(--color-border); }
  .suggestions a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .suggestions a:hover { opacity: 0.6; }
  .post-title {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .post-date {
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>
