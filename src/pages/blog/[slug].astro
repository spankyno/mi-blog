---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';
import { cloudinaryOptimize } from '../../lib/images';

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;
let post = null;

if (db) {
  const result = await db.prepare(
    `SELECT * FROM posts WHERE slug = ? AND draft != 1`
  ).bind(slug).first();
  post = result;
}

if (!post) return Astro.redirect('/blog');

const contentHtml = sanitizeHtml(String(await marked(post.content ?? '')), {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat(['img', 'h1', 'h2', 'h3', 'br']),
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    'img': ['src', 'alt', 'class', 'style', 'width', 'height'],
    'a': ['href', 'target', 'rel'],
    'p': ['style'],
    'div': ['style'],
    'span': ['style'],
    '*': ['class', 'style']
  },
  allowedStyles: {
    '*': {
      'width': [/^\d+(%|px|em|rem|vw)$/],
      'max-width': [/^\d+(%|px|em|rem|vw)$/],
      'min-width': [/^\d+(%|px|em|rem|vw)$/],
      'height': [/^\d+(%|px|em|rem|vh)$/],
      'display': [/^(block|inline|inline-block|flex|none)$/],
      'margin': [/^[\d\s.]+(%|px|em|rem|auto).*$/],
      'margin-top': [/^[\d.]+(px|em|rem|%)$|^auto$/],
      'margin-bottom': [/^[\d.]+(px|em|rem|%)$|^auto$/],
      'margin-left': [/^[\d.]+(px|em|rem|%)$|^auto$/],
      'margin-right': [/^[\d.]+(px|em|rem|%)$|^auto$/],
      'padding': [/^[\d\s.]+(px|em|rem|%).*$/],
      'text-align': [/^(left|right|center|justify)$/],
      'float': [/^(left|right|none)$/],
      'border-radius': [/^[\d.]+(px|em|rem|%).*$/],
      'background': [/^#[0-9a-fA-F]{3,8}$|^rgb|^rgba|^[a-z]+$/],
      'background-color': [/^#[0-9a-fA-F]{3,8}$|^rgb|^rgba|^[a-z]+$/],
      'color': [/^#[0-9a-fA-F]{3,8}$|^rgb|^rgba|^[a-z]+$/],
      'font-size': [/^[\d.]+(px|em|rem|%)$/],
      'font-weight': [/^(normal|bold|[1-9]00)$/],
      'line-height': [/^[\d.]+(%|px|em|rem)?$/],
      'opacity': [/^[01]?\.?\d*$/],
      'border': [/^.+$/],
      'border-left': [/^.+$/],
    }
  }
});

// Registrar visita de forma no bloqueante (ignorar prefetch de View Transitions)
const isPrefetch = Astro.request.headers.get('Purpose') === 'prefetch' ||
                   Astro.request.headers.get('Sec-Purpose') === 'prefetch' ||
                   Astro.request.headers.get('X-Purpose') === 'prefetch';

if (db && !isPrefetch) {
  try {
    const req = Astro.request;
    const hdrs = req.headers;
    const ip = hdrs.get('cf-connecting-ip') ?? hdrs.get('x-forwarded-for') ?? null;
    const country = hdrs.get('cf-ipcountry') ?? null;
    const cf = (Astro.locals.runtime?.cf as any) ?? null;
    const region = cf?.region ?? hdrs.get('cf-region') ?? null;
    const city = cf?.city ?? hdrs.get('cf-ipcity') ?? null;
    const userAgent = hdrs.get('user-agent') ?? null;
    const referer = hdrs.get('referer') ?? null;
    const botPatterns = /bot|crawler|spider|curl|python|wget|scrapy|headless/i;
    const isBot = userAgent ? (botPatterns.test(userAgent) ? 1 : 0) : 0;
    const viewedAt = new Date().toISOString();

    const insertPromise = db.prepare(
      `INSERT INTO page_views (slug, viewed_at, ip, country, region, city, user_agent, referer, is_bot)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`
    ).bind(slug, viewedAt, ip, country, region, city, userAgent, referer, isBot).run();

    if (Astro.locals.runtime?.ctx?.waitUntil) {
      Astro.locals.runtime.ctx.waitUntil(insertPromise);
    } else {
      await insertPromise;
    }
  } catch (e) {
    console.error('Error registrando visita:', e);
  }
}

// Cargar comentarios aprobados
let comments: any[] = [];
if (db) {
  const res = await db.prepare(
    `SELECT id, autor, contenido, created_at FROM comments
     WHERE slug = ? AND estado = 'aprobado'
     ORDER BY created_at ASC`
  ).bind(slug).all();
  comments = res.results ?? [];
}

// Posts anterior y siguiente
let postAnterior: any = null;
let postSiguiente: any = null;
if (db) {
  const [rAnterior, rSiguiente] = await Promise.all([
    db.prepare(
      `SELECT slug, title, hero_image FROM posts WHERE draft != 1 AND pub_date < ? ORDER BY pub_date DESC LIMIT 1`
    ).bind(post.pub_date).first(),
    db.prepare(
      `SELECT slug, title, hero_image FROM posts WHERE draft != 1 AND pub_date > ? ORDER BY pub_date ASC LIMIT 1`
    ).bind(post.pub_date).first(),
  ]);
  postAnterior = rAnterior ?? null;
  postSiguiente = rSiguiente ?? null;
}

const SITE_URL = 'https://aitorsanchez.pages.dev';
const postUrl = `${SITE_URL}/blog/${slug}`;
const ogImage = post.hero_image?.startsWith('http')
  ? cloudinaryOptimize(post.hero_image, 1200)
  : `${SITE_URL}/images/foto-portada.webp`;

const shareX = `https://x.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(postUrl)}`;
const shareWa = `https://wa.me/?text=${encodeURIComponent(`${post.title} ${postUrl}`)}`;
const shareEmail = `mailto:?subject=${encodeURIComponent(post.title)}&body=${encodeURIComponent(`Te comparto este artículo:\n\n${post.title}\n${postUrl}`)}`;
---
<Base
  title={post.title}
  description={post.description ?? undefined}
  ogType="article"
  ogImage={ogImage}
  pubDate={post.pub_date}
  heroImage={cloudinaryOptimize(post.hero_image, 1200)}
  heroImageMobile={cloudinaryOptimize(post.hero_image, 640)}
>
  <Header />
  <main>
    <article>
      <header>
        <p class="date">{new Date(post.pub_date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        <h1>{post.title}</h1>
        <p class="desc">{post.description}</p>
      </header>
      {post.hero_image && (
        <picture>
          <source media="(max-width: 640px)" srcset={cloudinaryOptimize(post.hero_image, 640)} type="image/webp" />
          <img
            src={cloudinaryOptimize(post.hero_image, 1200)}
            alt={post.title}
            class="hero-img"
            width="1200"
            height="300"
            loading="eager"
            fetchpriority="high"
            transition:name={`hero-${slug}`}
            transition:animate="initial"
          />
        </picture>
      )}
      <div class="content" set:html={contentHtml} />
    </article>

    <!-- Compartir -->
    <div class="share-section">
      <p class="share-label">Comparte este artículo</p>
      <div class="share-buttons">
        <a href={shareX} target="_blank" rel="noopener noreferrer" class="share-btn share-x" aria-label="Compartir en X">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.63 5.905-5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          X
        </a>
        <a href={shareWa} target="_blank" rel="noopener noreferrer" class="share-btn share-wa" aria-label="Compartir en WhatsApp">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp
        </a>
        <a href={shareEmail} class="share-btn share-email" aria-label="Compartir por Email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          Email
        </a>
      </div>
    </div>

    <section class="comments-section">
      <h2>Comentarios{comments.length > 0 ? ` (${comments.length})` : ''}</h2>

      {comments.length === 0 && (
        <p class="no-comments">Sé el primero en comentar.</p>
      )}

      {comments.map((c: any) => (
        <div class="comment">
          <div class="comment-meta">
            <strong>{c.autor}</strong>
            <span class="comment-date">
              {new Date(c.created_at).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
          </div>
          <p class="comment-body">{c.contenido}</p>
        </div>
      ))}

      <div class="comment-form">
        <h3>Deja un comentario</h3>
        <p class="form-note">Tu comentario será revisado antes de publicarse.</p>
        <div id="form-success" class="form-success" style="display:none">
          ✓ Comentario enviado. Será visible tras su revisión.
        </div>
        <div id="form-error" class="form-error" style="display:none">
          Error al enviar el comentario. Inténtalo de nuevo.
        </div>
        <div class="form-fields">
          <input id="autor" type="text" placeholder="Nombre *" maxlength="100" />
          <input id="email" type="email" placeholder="Email (opcional)" maxlength="200" />
          <textarea id="contenido" placeholder="Tu comentario *" rows="4" maxlength="2000"></textarea>
          <button id="submit-btn" onclick="enviarComentario()">Enviar comentario</button>
        </div>
      </div>
    </section>

    <!-- Navegación anterior/siguiente -->
    {(postAnterior || postSiguiente) && (
      <nav class="post-nav">
        <div class="post-nav-inner">
          {postAnterior ? (
            <a href={`/blog/${postAnterior.slug}`} class="post-nav-link post-nav-prev">
              {postAnterior.hero_image && (
                <img src={cloudinaryOptimize(postAnterior.hero_image, 400)} alt={postAnterior.title} class="post-nav-img" loading="lazy" width="400" height="100" />
              )}
              <div class="post-nav-content">
                <span class="post-nav-label">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="19" x2="5" y1="12" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                  Anterior
                </span>
                <span class="post-nav-title">{postAnterior.title}</span>
              </div>
            </a>
          ) : <div />}
          {postSiguiente ? (
            <a href={`/blog/${postSiguiente.slug}`} class="post-nav-link post-nav-next">
              {postSiguiente.hero_image && (
                <img src={cloudinaryOptimize(postSiguiente.hero_image, 400)} alt={postSiguiente.title} class="post-nav-img" loading="lazy" width="400" height="100" />
              )}
              <div class="post-nav-content">
                <span class="post-nav-label">
                  Siguiente
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="5" x2="19" y1="12" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </span>
                <span class="post-nav-title">{postSiguiente.title}</span>
              </div>
            </a>
          ) : <div />}
        </div>
      </nav>
    )}

    <a href="/blog" class="back">← Volver al blog</a>
  </main>
  <Footer />
</Base>

<script define:vars={{ slug }}>
  async function enviarComentario() {
    const autor = document.getElementById('autor').value.trim();
    const email = document.getElementById('email').value.trim();
    const contenido = document.getElementById('contenido').value.trim();
    const btn = document.getElementById('submit-btn');
    const successMsg = document.getElementById('form-success');
    const errorMsg = document.getElementById('form-error');

    successMsg.style.display = 'none';
    errorMsg.style.display = 'none';

    if (!autor || !contenido) {
      errorMsg.textContent = 'El nombre y el comentario son obligatorios.';
      errorMsg.style.display = 'block';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Enviando...';

    try {
      const res = await fetch('/api/comments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, autor, email, contenido }),
      });

      if (res.ok) {
        successMsg.style.display = 'block';
        document.getElementById('autor').value = '';
        document.getElementById('email').value = '';
        document.getElementById('contenido').value = '';
      } else {
        errorMsg.textContent = 'Error al enviar el comentario. Inténtalo de nuevo.';
        errorMsg.style.display = 'block';
      }
    } catch {
      errorMsg.textContent = 'Error de conexión. Inténtalo de nuevo.';
      errorMsg.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Enviar comentario';
    }
  }
  window.enviarComentario = enviarComentario;
</script>

<style>
  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  article { padding: 3rem 0 4rem; }
  header { margin-bottom: 2rem; border-bottom: 1px solid var(--color-border); padding-bottom: 2rem; }
  .date { font-size: 0.875rem; color: var(--color-muted); margin-bottom: 1rem; }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .desc { color: var(--color-muted); font-size: 1.05rem; }
  .hero-img {
    width: 100%;
    aspect-ratio: 1200 / 480;
    object-fit: cover;
    margin-bottom: 2rem;
    /* color de fondo mientras carga: elimina flash blanco (CLS visual) */
    background: #0d1b2e;
  }


  /* Compartir */
  .share-section { border-top: 1px solid var(--color-border); padding: 1.75rem 0; }
  .share-label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted); margin-bottom: 0.9rem; font-weight: 500; }
  .share-buttons { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .share-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.875rem; font-weight: 500; text-decoration: none; transition: opacity 0.2s; }
  .share-btn:hover { opacity: 0.85; }
  .share-x { background: #000; color: #fff; }
  .share-wa { background: #25D366; color: #fff; }
  .share-email { background: #f0f0ee; color: var(--color-text); border: 1px solid var(--color-border); }

  /* Comentarios */
  .comments-section { border-top: 1px solid var(--color-border); padding: 2.5rem 0 3rem; }
  .comments-section h2 { font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; margin-bottom: 1.5rem; }
  .no-comments { color: var(--color-muted); font-size: 0.95rem; margin-bottom: 2rem; }
  .comment { padding: 1.25rem 0; border-bottom: 1px solid var(--color-border); }
  .comment-meta { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.5rem; }
  .comment-meta strong { font-weight: 500; }
  .comment-date { font-size: 0.8rem; color: var(--color-muted); }
  .comment-body { font-size: 0.95rem; line-height: 1.7; white-space: pre-wrap; }
  .comment-form { margin-top: 2.5rem; }
  .comment-form h3 { font-size: 1.1rem; font-weight: 500; margin-bottom: 0.25rem; }
  .form-note { font-size: 0.85rem; color: var(--color-muted); margin-bottom: 1.25rem; }
  .form-success { background: #d1fae5; color: #065f46; padding: 0.75rem 1rem; border-radius: 6px; font-size: 0.9rem; margin-bottom: 1rem; }
  .form-error { background: #fee2e2; color: #dc2626; padding: 0.75rem 1rem; border-radius: 6px; font-size: 0.9rem; margin-bottom: 1rem; }
  .form-fields { display: flex; flex-direction: column; gap: 0.75rem; }
  .form-fields input, .form-fields textarea {
    width: 100%; padding: 0.65rem 0.9rem; border: 1px solid var(--color-border);
    border-radius: 6px; font-family: var(--font-body); font-size: 0.95rem;
    background: var(--color-bg); color: var(--color-text); transition: border-color 0.2s;
  }
  .form-fields input:focus, .form-fields textarea:focus { outline: none; border-color: var(--color-text); }
  .form-fields textarea { resize: vertical; min-height: 100px; }
  .form-fields button {
    align-self: flex-start; background: var(--color-text); color: var(--color-bg);
    border: none; padding: 0.6rem 1.5rem; border-radius: 6px; font-family: var(--font-body);
    font-size: 0.9rem; cursor: pointer; transition: opacity 0.2s;
  }
  .form-fields button:hover { opacity: 0.75; }
  .form-fields button:disabled { opacity: 0.5; cursor: not-allowed; }
  /* Navegación anterior/siguiente */
  .post-nav {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0 1.5rem;
  }
  .post-nav-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0;
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    transition: border-color 0.2s, background 0.2s;
  }
  .post-nav-link:hover {
    border-color: var(--color-text);
    background: #f9f9f7;
  }
  .post-nav-img {
    width: 100%;
    height: 100px;
    object-fit: cover;
    display: block;
  }
  .post-nav-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
  }
  .post-nav-next { text-align: right; }
  .post-nav-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-muted);
  }
  .post-nav-next .post-nav-label { justify-content: flex-end; }
  .post-nav-title {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 480px) {
    .post-nav-inner { grid-template-columns: 1fr; }
    .post-nav-next { text-align: left; }
  }

  .back { font-size: 0.875rem; color: var(--color-muted); transition: color 0.2s; display: inline-block; margin-bottom: 3rem; }
  .back:hover { color: var(--color-text); }
</style>
