---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const db = Astro.locals.runtime?.env?.DB;
let posts = [];

if (db) {
  const postsResult = await db.prepare(
    `SELECT slug, title, description, pub_date, hero_image FROM posts WHERE draft != 1 ORDER BY pub_date DESC LIMIT 6`
  ).all();
  posts = postsResult.results ?? [];
}
---
<Base title="Aitor Sánchez Gutiérrez">
  <Header />

  <section class="hero">
    <img src="/images/foto-portada.webp" alt="Aitor Sánchez" fetchpriority="high" />
  </section>

  <main>
    <section class="posts-section">
      <div class="section-header">
        <div class="section-label">Últimas entradas</div>
        <a href="/blog" class="see-all">
          Ver todas
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="5" x2="19" y1="12" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="grid">
        {posts.map((post: any, i: number) => (
          <a href={`/blog/${post.slug}`} class={`card ${i === 0 ? 'card-featured' : ''}`} style={`animation-delay: ${i * 80}ms`}>
            <div class="card-img">
              {post.hero_image
                ? <img src={post.hero_image} alt={post.title} loading={i === 0 ? 'eager' : 'lazy'} transition:name={`hero-${post.slug}`} transition:animate="initial" />
                : <div class="card-placeholder">
                    <span>{post.title.charAt(0)}</span>
                  </div>
              }
              <div class="card-img-overlay"></div>
            </div>
            <div class="card-body">
              <time class="card-date">{new Date(post.pub_date).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
              <h3 class="card-title">{post.title}</h3>
              {post.description && <p class="card-desc">{post.description}</p>}
              <span class="card-cta">
                Leer artículo
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><line x1="5" x2="19" y1="12" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>
        ))}
        {posts.length === 0 && <p class="empty">Próximamente…</p>}
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .hero {
    width: 100%;
    margin-bottom: 0;
    line-height: 0;
  }
  .hero img {
    width: 100%;
    height: auto;
    display: block;
  }

  main {
    padding: 0 1.5rem 5rem;
  }

  .posts-section {
    max-width: 1100px;
    margin: 0 auto;
    padding-top: 3.5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .section-label {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .see-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: #6366f1;
    text-decoration: none;
    padding: 0.4rem 1rem;
    border: 1px solid #e0e0ff;
    border-radius: 99px;
    background: #f5f5ff;
    transition: all 0.2s;
  }
  .see-all:hover {
    background: #6366f1;
    color: #fff;
    border-color: #6366f1;
  }
  html[data-theme='dark'] .see-all {
    background: rgba(99, 102, 241, 0.12);
    border-color: rgba(99, 102, 241, 0.35);
    color: #a5b4fc;
  }
  html[data-theme='dark'] .see-all:hover {
    background: #6366f1;
    color: #fff;
    border-color: #6366f1;
  }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* Card base */
  .card {
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid #ebebf0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04), 0 0 0 0 rgba(99,102,241,0);
    transition: transform 0.25s cubic-bezier(.22,.68,0,1.2), box-shadow 0.25s ease, border-color 0.2s;
    display: flex;
    flex-direction: column;
    animation: fadeUp 0.5s ease both;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(99,102,241,0.12), 0 2px 8px rgba(0,0,0,0.06);
    border-color: #c7c7f5;
  }
  html[data-theme='dark'] .card {
    background: #1a1a1a;
    border-color: rgba(255,255,255,0.08);
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }
  html[data-theme='dark'] .card:hover {
    border-color: rgba(99,102,241,0.5);
    box-shadow: 0 12px 32px rgba(99,102,241,0.15), 0 2px 8px rgba(0,0,0,0.4);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Imagen */
  .card-img {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #f0f0f5;
    flex-shrink: 0;
  }
  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .card:hover .card-img img { transform: scale(1.04); }
  .card-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(10,10,20,0.18) 100%);
    pointer-events: none;
  }
  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #e8e8f5 0%, #d8d8ee 100%);
  }
  .card-placeholder span {
    font-family: var(--font-display);
    font-size: 3rem;
    color: #9999cc;
    font-style: italic;
  }
  html[data-theme='dark'] .card-placeholder {
    background: linear-gradient(135deg, #1e1e2e 0%, #16162a 100%);
  }
  html[data-theme='dark'] .card-placeholder span { color: #4a4a7a; }

  /* Body */
  .card-body {
    padding: 1.1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }
  .card-date {
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #9090aa;
  }
  html[data-theme='dark'] .card-date { color: #6b6b80; }
  .card-title {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    color: #12121e;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  html[data-theme='dark'] .card-title { color: #e5e5e5; }
  .card-desc {
    font-size: 0.8rem;
    color: #7070888;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: #888899;
    margin-top: 0.1rem;
  }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #6366f1;
    margin-top: auto;
    padding-top: 0.6rem;
    letter-spacing: 0.02em;
    transition: gap 0.2s;
  }
  .card:hover .card-cta { gap: 0.5rem; }

  /* Tarjeta destacada — ocupa 2 columnas en la primera fila */
  .card-featured {
    grid-column: span 2;
  }
  .card-featured .card-img {
    aspect-ratio: 21/9;
  }
  .card-featured .card-title {
    font-size: 1.1rem;
    -webkit-line-clamp: 2;
  }
  .card-featured .card-desc {
    font-size: 0.85rem;
    -webkit-line-clamp: 2;
  }

  .empty {
    color: var(--color-muted);
    font-size: 0.9rem;
    grid-column: span 3;
    padding: 2rem 0;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
    .card-featured { grid-column: span 2; }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    .card-featured { grid-column: span 1; }
    .card-featured .card-img { aspect-ratio: 16/9; }
  }
</style>
