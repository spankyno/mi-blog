---
import Base from '../../layouts/Base.astro';

const db = Astro.locals.runtime?.env?.DB;
let posts = [];
let pendientes = 0;

// Leer parámetros de ordenación
const url = new URL(Astro.request.url);
const sortParam = url.searchParams.get('sort') ?? 'pub_date';
const dirParam = url.searchParams.get('dir') ?? 'desc';

// Columnas permitidas para evitar SQL injection
const allowedSort: Record<string, string> = {
  title: 'title',
  pub_date: 'pub_date',
  estado: 'draft',
};
const sortCol = allowedSort[sortParam] ?? 'pub_date';
const sortDir = dirParam === 'asc' ? 'ASC' : 'DESC';

if (db) {
  const [rPosts, rPendientes] = await Promise.all([
    db.prepare(`SELECT slug, title, pub_date, draft FROM posts ORDER BY ${sortCol} ${sortDir}`).all(),
    db.prepare(`SELECT COUNT(*) as n FROM comments WHERE estado = 'pendiente'`).first(),
  ]);
  posts = rPosts.results ?? [];
  pendientes = (rPendientes as any)?.n ?? 0;
}

// Función para generar URL de ordenación
function sortUrl(col: string) {
  const newDir = sortParam === col && dirParam === 'asc' ? 'desc' : 'asc';
  return `/panel?sort=${col}&dir=${newDir}`;
}

// Flecha indicadora
function arrow(col: string) {
  if (sortParam !== col) return '';
  return dirParam === 'asc' ? ' ↑' : ' ↓';
}
---
<Base title="Panel — Aitor Sánchez">
  <main>
    <div class="topbar">
      <h1>Panel</h1>
      <div class="topbar-actions">
        <a href="/blog" target="_blank" class="btn-blog">Ver blog ↗</a>
        <a href="/panel/comentarios" class="btn-blog btn-comentarios">
          Comentarios
          {pendientes > 0 && <span class="badge-pendientes">{pendientes}</span>}
        </a>
        <a href="/panel/stats" class="btn-blog">Estadísticas</a>
        <a href="/panel/nuevo" class="btn-new">+ Nuevo post</a>
        <button onclick="cerrarSesion()" class="btn-logout">Cerrar sesión</button>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th><a href={sortUrl('title')} class={`sort-link ${sortParam === 'title' ? 'active' : ''}`}>Título{arrow('title')}</a></th>
          <th><a href={sortUrl('pub_date')} class={`sort-link ${sortParam === 'pub_date' ? 'active' : ''}`}>Fecha{arrow('pub_date')}</a></th>
          <th><a href={sortUrl('estado')} class={`sort-link ${sortParam === 'estado' ? 'active' : ''}`}>Estado{arrow('estado')}</a></th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        {posts.map((post: any) => (
          <tr>
            <td>{post.title}</td>
            <td>{new Date(post.pub_date).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}</td>
            <td>
              <span class={post.draft ? 'badge draft' : 'badge published'}>
                {post.draft ? 'Borrador' : 'Publicado'}
              </span>
            </td>
            <td class="actions">
              <a href={`/panel/editar/${post.slug}`} class="btn-edit">Editar</a>
              <a href={`/panel/preview/${post.slug}`} class="btn-view">Ver</a>
              <button
                class="btn-delete"
                data-slug={post.slug}
                onclick="deletePost(this)"
              >Borrar</button>
            </td>
          </tr>
        ))}
        {posts.length === 0 && (
          <tr><td colspan="4" class="empty">No hay posts todavía.</td></tr>
        )}
      </tbody>
    </table>

    <!-- Exportar datos -->
    <div class="export-section">
      <h2>Exportar datos</h2>
      <div class="export-buttons">
        <a href="/api/panel/export?tabla=posts" class="btn-export">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>
          </svg>
          Posts
        </a>
        <a href="/api/panel/export?tabla=comments" class="btn-export">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>
          </svg>
          Comentarios
        </a>
        <a href="/api/panel/export?tabla=page_views" class="btn-export">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>
          </svg>
          Visitas
        </a>
      </div>
    </div>
  </main>
</Base>

<script>
  async function deletePost(btn: HTMLButtonElement) {
    const slug = btn.dataset.slug;
    if (!confirm(`¿Borrar "${slug}"? Esta acción no se puede deshacer.`)) return;

    const res = await fetch('/api/panel/posts', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slug }),
    });

    if (res.ok) {
      btn.closest('tr')?.remove();
    } else {
      alert('Error al borrar el post.');
    }
  }

  async function cerrarSesion() {
    await fetch('/api/panel/logout', { method: 'POST' });
    window.location.href = '/panel/login';
  }

  (window as any).deletePost = deletePost;
  (window as any).cerrarSesion = cerrarSesion;
</script>

<style>
  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }
  .topbar-actions { display: flex; gap: 0.75rem; align-items: center; }
  .btn-blog {
    font-size: 0.9rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.5rem 1.25rem;
    border-radius: 4px;
    transition: color 0.2s, border-color 0.2s;
    text-decoration: none;
  }
  .btn-blog:hover { color: var(--color-text); border-color: var(--color-text); }
  .btn-comentarios {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .badge-pendientes {
    background: #dc2626;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 99px;
    line-height: 1.4;
    min-width: 18px;
    text-align: center;
  }
  h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .btn-new {
    background: var(--color-text);
    color: var(--color-bg);
    padding: 0.5rem 1.25rem;
    font-size: 0.9rem;
    border-radius: 4px;
    transition: opacity 0.2s;
    text-decoration: none;
  }
  .btn-new:hover { opacity: 0.75; }
  .btn-logout {
    font-size: 0.9rem;
    color: #dc2626;
    border: 1px solid #fca5a5;
    padding: 0.5rem 1.25rem;
    border-radius: 4px;
    background: transparent;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-logout:hover { background: #fee2e2; }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  th {
    text-align: left;
    font-weight: 500;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .sort-link {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s;
    font-weight: 500;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .sort-link:hover { color: var(--color-text); }
  .sort-link.active { color: var(--color-text); }
  td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }
  tr:hover td { background: #f5f5f2; }

  .badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 99px;
    font-weight: 500;
  }
  .badge.published { background: #d1fae5; color: #065f46; }
  .badge.draft { background: #fef3c7; color: #92400e; }

  .actions { display: flex; gap: 0.5rem; }
  .btn-edit, .btn-delete {
    font-size: 0.8rem;
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    cursor: pointer;
    border: 1px solid var(--color-border);
    background: transparent;
    font-family: inherit;
    transition: background 0.15s;
  }
  .btn-edit { color: var(--color-text); text-decoration: none; }
  .btn-edit:hover { background: var(--color-border); }
  .btn-view { color: #0369a1; border-color: #bae6fd; text-decoration: none; }
  .btn-view:hover { background: #e0f2fe; }
  .btn-delete { color: #dc2626; border-color: #fca5a5; }
  .btn-delete:hover { background: #fee2e2; }

  .empty { color: var(--color-muted); padding: 2rem 1rem; }

  /* Exportar */
  .export-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .export-section h2 {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }
  .export-buttons { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .btn-export {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.45rem 1rem;
    border-radius: 4px;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }
  .btn-export:hover { color: var(--color-text); border-color: var(--color-text); }
</style>
