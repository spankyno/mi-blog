---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';

const { slug } = Astro.params;

const JWT_COOKIE = 'panel_token';
const cookie = Astro.request.headers.get('cookie') ?? '';
const token = cookie.split(';').find(c => c.trim().startsWith(`${JWT_COOKIE}=`))?.split('=')[1]?.trim();
const secret = Astro.locals.runtime?.env?.JWT_SECRET;

if (!token || !secret) {
  return Astro.redirect('/panel/login');
}

async function verifyJWT(t: string, s: string): Promise<boolean> {
  try {
    const [headerB64, payloadB64, signatureB64] = t.split('.');
    if (!headerB64 || !payloadB64 || !signatureB64) return false;
    const payload = JSON.parse(atob(payloadB64.replace(/-/g, '+').replace(/_/g, '/')));
    if (payload.exp && payload.exp < Math.floor(Date.now() / 1000)) return false;
    const key = await crypto.subtle.importKey(
      'raw', new TextEncoder().encode(s),
      { name: 'HMAC', hash: 'SHA-256' }, false, ['verify']
    );
    const sig = Uint8Array.from(
      atob(signatureB64.replace(/-/g, '+').replace(/_/g, '/')),
      c => c.charCodeAt(0)
    );
    return await crypto.subtle.verify('HMAC', key, sig, new TextEncoder().encode(`${headerB64}.${payloadB64}`));
  } catch { return false; }
}

if (!await verifyJWT(token, secret)) {
  return Astro.redirect('/panel/login');
}

const db = Astro.locals.runtime?.env?.DB;
let post: any = null;

if (db) {
  post = await db.prepare(`SELECT * FROM posts WHERE slug = ?`).bind(slug).first();
}

if (!post) return Astro.redirect('/panel');

const contentHtml = sanitizeHtml(String(await marked(post.content ?? '')), {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat(['img', 'h1', 'h2', 'h3', 'br']),
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    'img': ['src', 'alt', 'class', 'style', 'width', 'height'],
    'a': ['href', 'target', 'rel'],
    'p': ['style'],
    'div': ['style'],
    'span': ['style'],
    '*': ['class', 'style']
  },
  allowedStyles: {
    '*': {
      'width': [/^\d+(%|px|em|rem|vw)$/],
      'max-width': [/^\d+(%|px|em|rem|vw)$/],
      'min-width': [/^\d+(%|px|em|rem|vw)$/],
      'height': [/^\d+(%|px|em|rem|vh)$/],
      'display': [/^(block|inline|inline-block|flex|none)$/],
      'margin': [/^[\d\s.]+(%|px|em|rem|auto).*$/],
      'margin-top': [/^[\d.]+(px|em|rem|%)$|^auto$/],
      'margin-bottom': [/^[\d.]+(px|em|rem|%)$|^auto$/],
      'margin-left': [/^[\d.]+(px|em|rem|%)$|^auto$/],
      'margin-right': [/^[\d.]+(px|em|rem|%)$|^auto$/],
      'padding': [/^[\d\s.]+(px|em|rem|%).*$/],
      'text-align': [/^(left|right|center|justify)$/],
      'float': [/^(left|right|none)$/],
      'border-radius': [/^[\d.]+(px|em|rem|%).*$/],
      'background': [/^#[0-9a-fA-F]{3,8}$|^rgb|^rgba|^[a-z]+$/],
      'background-color': [/^#[0-9a-fA-F]{3,8}$|^rgb|^rgba|^[a-z]+$/],
      'color': [/^#[0-9a-fA-F]{3,8}$|^rgb|^rgba|^[a-z]+$/],
      'font-size': [/^[\d.]+(px|em|rem|%)$/],
      'font-weight': [/^(normal|bold|[1-9]00)$/],
      'line-height': [/^[\d.]+(%|px|em|rem)?$/],
      'opacity': [/^[01]?\.?\d*$/],
      'border': [/^.+$/],
      'border-left': [/^.+$/],
    }
  }
});
---
<Base title={`Preview: ${post.title}`}>
  <Header />
  <div class="preview-bar">
    <span class="preview-badge">Vista previa {post.draft ? '— Borrador' : '— Publicado'}</span>
    <div class="preview-actions">
      <a href={`/panel/editar/${post.slug}`} class="btn-edit">← Editar</a>
      <a href={`/blog/${post.slug}`} target="_blank" class="btn-live">Ver en blog ↗</a>
    </div>
  </div>
  <main>
    <article>
      <header>
        <p class="date">{new Date(post.pub_date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        <h1>{post.title}</h1>
        {post.description && <p class="desc">{post.description}</p>}
      </header>
      {post.hero_image && (
        <img src={post.hero_image} alt={post.title} class="hero-img" />
      )}
      <div class="content" set:html={contentHtml} />
    </article>
    <a href="/panel" class="back">← Volver al panel</a>
  </main>
</Base>

<style>
  /* ── Preview bar ── */
  .preview-bar {
    background: var(--preview-bar-bg);
    border-bottom: 1px solid var(--preview-bar-border);
    padding: 0.6rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  :root {
    --preview-bar-bg: #fef9c3;
    --preview-bar-border: #fde047;
    --preview-bar-text: #854d0e;
    --preview-bar-hover: #fde047;
  }
  html[data-theme='dark'] {
    --preview-bar-bg: #2a2200;
    --preview-bar-border: #4a3800;
    --preview-bar-text: #fbbf24;
    --preview-bar-hover: #4a3800;
  }
  .preview-badge { color: var(--preview-bar-text); font-weight: 500; }
  .preview-actions { display: flex; gap: 0.75rem; }
  .btn-edit, .btn-live {
    font-size: 0.8rem;
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    border: 1px solid var(--preview-bar-border);
    color: var(--preview-bar-text);
    transition: background 0.15s;
  }
  .btn-edit:hover, .btn-live:hover { background: var(--preview-bar-hover); }

  /* ── Layout ── */
  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  article { padding: 3rem 0 4rem; }
  header { margin-bottom: 2rem; border-bottom: 1px solid var(--color-border); padding-bottom: 2rem; }
  .date { font-size: 0.875rem; color: var(--color-muted); margin-bottom: 1rem; }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .desc { color: var(--color-muted); font-size: 1.05rem; }
  .hero-img {
    width: 100%;
    aspect-ratio: 1200 / 480;
    object-fit: cover;
    margin-bottom: 2rem;
    border-radius: 4px;
    background: #0d1b2e;
  }

  .back { font-size: 0.875rem; color: var(--color-muted); transition: color 0.2s; display: inline-block; margin-bottom: 2rem; }
  .back:hover { color: var(--color-text); }
</style>
