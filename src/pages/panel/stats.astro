---
// Dashboard de estadísticas de visitas.
// Todo el estado vive en la URL (?p=7d&h=1&…): renderizado en servidor, enlaces compartibles
// y sin JS para filtrar. Lógica en src/lib/stats*.ts · piezas en src/components/stats/.
import Panel from '../../layouts/Panel.astro';
import StatsHeader from '../../components/stats/StatsHeader.astro';
import KpiCard from '../../components/stats/KpiCard.astro';
import TrendChart from '../../components/stats/TrendChart.astro';
import BarList from '../../components/stats/BarList.astro';
import type { BarItem } from '../../components/stats/BarList.astro';
import Donut from '../../components/stats/Donut.astro';
import VisitsTable from '../../components/stats/VisitsTable.astro';
import Insights from '../../components/stats/Insights.astro';
import Icon from '../../components/stats/Icon.astro';
import { loadStats, type StatsData } from '../../lib/stats-data';
import { botLevel, buildInsights, countryName, delta, flagEmoji, fmtInt, fmtPct, parseStatsQuery, pct, statsHref } from '../../lib/stats';

const query = parseStatsQuery(new URL(Astro.request.url).searchParams);
const db = Astro.locals.runtime?.env?.DB;

let data: StatsData | null = null;
let failure = '';
if (!db) failure = 'La base de datos no está disponible en este entorno.';
else {
  try { data = await loadStats(db, query); }
  catch (e) { console.error('[stats]', e); failure = 'No se pudieron consultar las visitas.'; }
}

const titleOf = (slug: string) => data?.titles[slug] ?? slug;
const periodLabel = data?.period.label ?? '';
const noData = !!data && data.cur.total === 0;

let kpis: { label: string; value: string; icon: string; delta: ReturnType<typeof delta>; invert?: boolean; badge?: { tone: 'good' | 'warn' | 'bad'; label: string }; wide?: boolean }[] = [];
let postItems: BarItem[] = [];
let countryItems: BarItem[] = [];
let insights: ReturnType<typeof buildInsights> = [];

if (data && !noData) {
  const { cur, prev } = data;
  const botNow = pct(cur.bots, cur.total);
  const botPrev = pct(prev.bots, prev.total);
  kpis = [
    { label: 'Visitas totales', value: fmtInt(cur.total), icon: 'eye', delta: delta(cur.total, prev.total) },
    { label: 'Visitas humanas', value: fmtInt(cur.humans), icon: 'users', delta: delta(cur.humans, prev.humans) },
    { label: 'Bots', value: fmtPct(botNow, 1), icon: 'bot', delta: delta(botNow, botPrev, 'pp'), invert: true, badge: botLevel(botNow) },
    { label: 'Posts visitados', value: fmtInt(cur.posts), icon: 'file', delta: delta(cur.posts, prev.posts) },
    { label: 'Países únicos', value: fmtInt(cur.countries), icon: 'globe', delta: delta(cur.countries, prev.countries), wide: true },
  ];
  postItems = data.posts.slice(0, 10).map((p) => ({
    key: p.key, label: titleOf(p.key), h: p.h, b: p.b,
    href: statsHref(query, { post: query.post === p.key ? '' : p.key }, '#visitas'),
    ext: `/blog/${p.key}`, active: query.post === p.key,
  }));
  countryItems = data.countries.slice(0, 10).map((c) => ({
    key: c.key, label: countryName(c.key), prefix: flagEmoji(c.key), sub: c.key, h: c.h, b: c.b,
    href: statsHref(query, { country: query.country === c.key ? '' : c.key }, '#visitas'), active: query.country === c.key,
  }));
  insights = buildInsights({ cur, prev, posts: data.posts, countries: data.countries, series: data.series, humansOnly: query.humans, titleOf });
}
---
<Panel title="Estadísticas — Panel" active="stats">
  <main class="dash" id="dash">
    <div class="wrap">
      <div class="topbar">
        <h1>Estadísticas</h1>
      </div>
      <p class="sr" role="status" id="busy-msg"></p>

      <StatsHeader query={query} periodLabel={periodLabel || 'Personalizado'} />

      {failure && (
        <section class="state" role="alert">
          <Icon name="alert" size={24} />
          <h2>No se pudieron cargar las estadísticas</h2>
          <p>{failure}</p>
          <a class="btn" href={statsHref(query, { page: query.page })} data-nav>Reintentar</a>
        </section>
      )}

      {noData && (
        <section class="state">
          <Icon name="inbox" size={24} />
          <h2>Sin visitas en este periodo</h2>
          <p>{periodLabel} no tiene visitas registradas. Prueba con un rango más amplio.</p>
          <div class="actions">
            {query.p !== '90d' && <a class="btn" href={statsHref(query, { p: '90d', from: null, to: null })} data-nav>Ver últimos 90 días</a>}
            {(query.post || query.country || query.q) && <a class="btn ghost" href={statsHref(query, { post: '', country: '', q: '' })} data-nav>Quitar filtros</a>}
          </div>
        </section>
      )}

      {data && !noData && (
        <>
          <section id="overview" aria-label="Resumen" class="kpis">
            {kpis.map((k) => <KpiCard {...k} />)}
          </section>

          <div class="mid">
            <TrendChart points={data.series} query={query} granularity={data.period.granularity} allowed={data.period.allowed} periodLabel={periodLabel} />
            <Insights items={insights} />
          </div>

          <div class="trio">
            <div id="posts">
              <BarList id="top-posts" title="Posts más visitados" subtitle={query.humans ? 'Solo lectores humanos · clic para filtrar la tabla' : 'Humanos y bots · clic para filtrar la tabla'}
                items={postItems} humansOnly={query.humans} unit="visitas" emptyText="Aún no hay visitas a posts." />
            </div>
            <div id="geografia">
              <BarList id="top-paises" title="Países" subtitle={query.humans ? 'Solo lectores humanos · clic para filtrar la tabla' : 'Humanos y bots · clic para filtrar la tabla'}
                items={countryItems} humansOnly={query.humans} unit="visitas" emptyText="Aún no hay datos de ubicación." />
            </div>
            <div class="donut"><Donut cur={data.cur} /></div>
          </div>

          <VisitsTable query={query} rows={data.rows} total={data.rowsTotal} page={data.page} pages={data.pages} titles={data.titles} />
        </>
      )}
    </div>
  </main>
</Panel>

<script>
  // Estado de carga: al navegar entre filtros (recarga completa en servidor) se muestra un esqueleto
  // sobre las tarjetas hasta que llega la nueva vista.
  const dash = document.getElementById('dash');
  const msg = document.getElementById('busy-msg');
  const busy = () => { dash?.setAttribute('aria-busy', 'true'); if (msg) msg.textContent = 'Cargando estadísticas…'; };
  const idle = () => { dash?.removeAttribute('aria-busy'); if (msg) msg.textContent = ''; };

  document.addEventListener('click', (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = (e.target as Element).closest('a[data-nav]') as HTMLAnchorElement | null;
    if (a && a.target !== '_blank') busy();
  });
  document.addEventListener('submit', (e) => { if ((e.target as Element).closest('[data-nav]')) busy(); });
  window.addEventListener('pageshow', (e) => { if (e.persisted) idle(); });
</script>

<style>
  .dash {
    /* Tokens del dashboard: se apoyan en las variables del sitio y definen solo lo que falta. */
    --st-card: #ffffff; --st-card-2: #f3f3ef; --st-line: #e9e9e4; --st-line-strong: #d8d8d1;
    --st-accent: #6366f1; --st-accent-solid: #4f52e0; --st-accent-fg: #4338ca;
    --st-human: #059669; --st-human-solid: #059669; --st-human-fg: #047857; --st-human-bg: #d1fae5;
    --st-bot: #d97706; --st-bot-fg: #92400e; --st-bot-bg: #fef3c7;
    --st-bad-fg: #b91c1c; --st-bad-bg: #fee2e2;
    font-variant-numeric: tabular-nums;
    container-type: inline-size;
  }
  html[data-theme='dark'] .dash {
    --st-card: #17171a; --st-card-2: #202025; --st-line: #26262c; --st-line-strong: #383840;
    --st-accent-fg: #a5b4fc;
    --st-human: #34d399; --st-human-solid: #10b981; --st-human-fg: #6ee7b7; --st-human-bg: rgba(16, 185, 129, 0.14);
    --st-bot: #fbbf24; --st-bot-fg: #fcd34d; --st-bot-bg: rgba(245, 158, 11, 0.15);
    --st-bad-fg: #fca5a5; --st-bad-bg: rgba(239, 68, 68, 0.16);
  }

  .wrap { max-width: 1280px; margin: 0 auto; padding: 1.75rem 1.5rem 4rem; display: grid; gap: 1rem; }
  .topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.25rem; }
  h1 { font-family: var(--font-display); font-size: 2rem; font-weight: 400; letter-spacing: -0.02em; margin: 0; }

  .kpis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.75rem; }
  .mid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 1rem; }
  .trio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; align-items: start; }
  #posts, #geografia, #overview, #insights { scroll-margin-top: 1rem; }

  @container (max-width: 1000px) {
    .kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .mid { grid-template-columns: minmax(0, 1fr); }
    .trio { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .donut { grid-column: 1 / -1; }
  }
  @container (max-width: 640px) {
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .trio { grid-template-columns: minmax(0, 1fr); }
    .wrap { padding-inline: 1rem; }
  }
  /* Sin container queries (navegadores antiguos): una columna segura. */
  @supports not (container-type: inline-size) {
    @media (max-width: 1000px) { .kpis { grid-template-columns: repeat(2, 1fr); } .mid, .trio { grid-template-columns: 1fr; } }
  }

  .state { display: grid; justify-items: center; gap: 0.5rem; text-align: center; padding: 3.5rem 1.5rem; background: var(--st-card); border: 1px dashed var(--st-line-strong); border-radius: 16px; color: var(--color-muted); }
  .state h2 { margin: 0.3rem 0 0; font-size: 1.05rem; font-weight: 600; color: var(--color-text); text-transform: none; letter-spacing: -0.01em; }
  .state p { margin: 0; font-size: 0.88rem; max-width: 34ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: 0.6rem; }
  .btn { padding: 0.5rem 1rem; border-radius: 10px; background: var(--st-accent-solid); color: #fff; text-decoration: none; font-size: 0.85rem; font-weight: 600; margin-top: 0.6rem; }
  .actions .btn { margin-top: 0; }
  .btn.ghost { background: transparent; color: var(--color-text); border: 1px solid var(--st-line-strong); }
  .btn:hover { filter: brightness(1.1); }
  .btn:focus-visible { outline: 2px solid var(--st-accent-fg); outline-offset: 2px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ── Esqueleto de carga (se activa con aria-busy desde el script) ── */
  .dash[aria-busy='true'] { cursor: progress; }
  .dash[aria-busy='true'] :global(.sk) { position: relative; pointer-events: none; }
  .dash[aria-busy='true'] :global(.sk > *) { visibility: hidden; }
  .dash[aria-busy='true'] :global(.sk)::after {
    content: ''; position: absolute; inset: 0; border-radius: 12px;
    background: linear-gradient(90deg, var(--st-card-2) 25%, color-mix(in srgb, var(--st-line-strong) 70%, var(--st-card-2)) 50%, var(--st-card-2) 75%);
    background-size: 200% 100%; animation: shimmer 1.3s linear infinite;
  }
  @keyframes shimmer { to { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) { .dash[aria-busy='true'] :global(.sk)::after { animation: none; } }
</style>
