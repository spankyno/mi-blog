---
import Base from '../../layouts/Base.astro';

const db = Astro.locals.runtime?.env?.DB;

let totalVisitas = 0;
let totalHumanas = 0;
let totalPosts = 0;
let totalPaises = 0;
let topPosts: any[] = [];
let topPaises: any[] = [];
let porDia: any[] = [];
let porMes: any[] = [];
let ultimas: any[] = [];

const countryNames: Record<string, string> = {
  ES: '🇪🇸 España', US: '🇺🇸 EE.UU.', BE: '🇧🇪 Bélgica', FR: '🇫🇷 Francia',
  DE: '🇩🇪 Alemania', MX: '🇲🇽 México', AR: '🇦🇷 Argentina', GB: '🇬🇧 Reino Unido',
  IT: '🇮🇹 Italia', PT: '🇵🇹 Portugal', BR: '🇧🇷 Brasil', CO: '🇨🇴 Colombia',
  CL: '🇨🇱 Chile', NL: '🇳🇱 Países Bajos', PL: '🇵🇱 Polonia', SE: '🇸🇪 Suecia',
};

if (db) {
  const [t, h, p, c] = await Promise.all([
    db.prepare(`SELECT COUNT(*) as n FROM page_views`).first(),
    db.prepare(`SELECT COUNT(*) as n FROM page_views WHERE is_bot = 0`).first(),
    db.prepare(`SELECT COUNT(DISTINCT slug) as n FROM page_views WHERE is_bot = 0`).first(),
    db.prepare(`SELECT COUNT(DISTINCT country) as n FROM page_views WHERE is_bot = 0 AND country IS NOT NULL`).first(),
  ]);
  totalVisitas = (t as any)?.n ?? 0;
  totalHumanas = (h as any)?.n ?? 0;
  totalPosts = (p as any)?.n ?? 0;
  totalPaises = (c as any)?.n ?? 0;

  const [rPosts, rPaises, rDia, rMes, rUltimas] = await Promise.all([
    db.prepare(`SELECT slug, COUNT(*) as n FROM page_views WHERE is_bot = 0 GROUP BY slug ORDER BY n DESC LIMIT 10`).all(),
    db.prepare(`SELECT country, COUNT(*) as n FROM page_views WHERE is_bot = 0 AND country IS NOT NULL GROUP BY country ORDER BY n DESC LIMIT 10`).all(),
    db.prepare(`SELECT DATE(viewed_at) as dia, COUNT(*) as n FROM page_views WHERE is_bot = 0 AND viewed_at >= DATE('now', '-6 days') GROUP BY dia ORDER BY dia ASC`).all(),
    db.prepare(`SELECT STRFTIME('%Y-%m', viewed_at) as mes, COUNT(*) as n FROM page_views WHERE is_bot = 0 AND viewed_at >= DATE('now', '-11 months', 'start of month') GROUP BY mes ORDER BY mes ASC`).all(),
    db.prepare(`SELECT slug, country, city, ip, viewed_at, is_bot FROM page_views ORDER BY viewed_at DESC LIMIT 500`).all(),
  ]);

  topPosts = rPosts.results ?? [];
  topPaises = rPaises.results ?? [];
  porDia = rDia.results ?? [];
  porMes = rMes.results ?? [];
  ultimas = rUltimas.results ?? [];
}

const maxPosts = topPosts[0]?.n ?? 1;
const maxPaises = topPaises[0]?.n ?? 1;
const maxDia = Math.max(...porDia.map((d: any) => d.n), 1);

const diasMap: Record<string, number> = {};
porDia.forEach((d: any) => { diasMap[d.dia] = d.n; });
const ultimos7: { dia: string; n: number; label: string }[] = [];
const diasSemana = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
for (let i = 6; i >= 0; i--) {
  const d = new Date();
  d.setDate(d.getDate() - i);
  const key = d.toISOString().split('T')[0];
  ultimos7.push({ dia: key, n: diasMap[key] ?? 0, label: diasSemana[d.getDay()] });
}

const mesesMap: Record<string, number> = {};
porMes.forEach((m: any) => { mesesMap[m.mes] = m.n; });
const ultimos12: { mes: string; n: number; label: string }[] = [];
const mesesNombre = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
for (let i = 11; i >= 0; i--) {
  const d = new Date();
  d.setDate(1);
  d.setMonth(d.getMonth() - i);
  const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  ultimos12.push({ mes: key, n: mesesMap[key] ?? 0, label: mesesNombre[d.getMonth()] });
}
const maxMes = Math.max(...ultimos12.map(m => m.n), 1);

const ultimasJson = JSON.stringify(ultimas);
---

<Base title="Estadísticas — Panel">
  <main>
    <div class="topbar">
      <h1>Estadísticas</h1>
      <a href="/panel" class="btn-back">← Panel</a>
    </div>

    <!-- Tarjetas resumen -->
    <div class="cards">
      <div class="card">
        <p class="card-label">Visitas totales</p>
        <p class="card-value">{totalVisitas}</p>
      </div>
      <div class="card">
        <p class="card-label">Visitas humanas</p>
        <p class="card-value">{totalHumanas}</p>
      </div>
      <div class="card">
        <p class="card-label">Posts visitados</p>
        <p class="card-value">{totalPosts}</p>
      </div>
      <div class="card">
        <p class="card-label">Países</p>
        <p class="card-value">{totalPaises}</p>
      </div>
    </div>

    <div class="grid-2">
      <!-- Top posts y otros gráficos (sin cambios) -->
      <div class="box">
        <h2>Posts más leídos</h2>
        {topPosts.length === 0 && <p class="empty">Sin datos todavía.</p>}
        {topPosts.map((p: any) => (
          <div class="bar-row">
            <div class="bar-info">
              <span class="bar-label" title={p.slug}>{p.slug}</span>
              <span class="bar-count">{p.n}</span>
            </div>
            <div class="bar-track">
              <div class="bar-fill bar-purple" style={`width: ${Math.round((p.n / maxPosts) * 100)}%`}></div>
            </div>
          </div>
        ))}
      </div>

      <div>
        <div class="box" style="margin-bottom: 1.25rem;">
          <h2>Visitas por país</h2>
          {topPaises.length === 0 && <p class="empty">Sin datos todavía.</p>}
          {topPaises.map((p: any) => (
            <div class="bar-row">
              <div class="bar-info">
                <span class="bar-label">{countryNames[p.country] ?? p.country}</span>
                <span class="bar-count">{p.n}</span>
              </div>
              <div class="bar-track">
                <div class="bar-fill bar-green" style={`width: ${Math.round((p.n / maxPaises) * 100)}%`}></div>
              </div>
            </div>
          ))}
        </div>

        <div class="box">
          <h2>Últimos 7 días</h2>
          <div class="chart">
            {ultimos7.map((d) => (
              <div class="chart-col">
                <span class="chart-val">{d.n > 0 ? d.n : ''}</span>
                <div class="chart-bar-wrap">
                  <div class="chart-bar" style={`height: ${d.n > 0 ? Math.max(8, Math.round((d.n / maxDia) * 80)) : 2}px; opacity: ${d.n > 0 ? 1 : 0.2}`}></div>
                </div>
                <span class="chart-label">{d.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Últimas visitas -->
    <div class="box" style="margin-top: 1.25rem;">
      <div class="section-header">
        <h2>Últimas visitas</h2>
        <span class="results-count" id="results-count"></span>
      </div>

      <!-- Filtros (sin cambios) -->
      <div class="filters">
        <div class="filter-group">
          <label for="f-desde">Desde</label>
          <input type="date" id="f-desde" />
        </div>
        <div class="filter-group">
          <label for="f-hasta">Hasta</label>
          <input type="date" id="f-hasta" />
        </div>
        <div class="filter-group">
          <label for="f-ip">IP</label>
          <input type="text" id="f-ip" placeholder="Filtrar por IP…" />
        </div>
        <div class="filter-group">
          <label for="f-bot">Bot</label>
          <select id="f-bot">
            <option value="">Todos</option>
            <option value="0">Solo humanos</option>
            <option value="1">Solo bots</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="f-limit">Mostrar</label>
          <select id="f-limit">
            <option value="20" selected>20</option>
            <option value="50">50</option>
            <option value="100">100</option>
            <option value="200">200</option>
            <option value="0">Todos</option>
          </select>
        </div>
        <button class="btn-reset" id="btn-reset" type="button">Limpiar</button>
      </div>

      {ultimas.length > 0 && (
        <div class="table-wrap">
          <table id="visitas-table">
            <thead>
              <tr>
                <th>Post</th>
                <th>País</th>
                <th>Ciudad</th>
                <th>IP</th>
                <th>Fecha</th>
                <th>Bot</th>
              </tr>
            </thead>
            <tbody id="visitas-body"></tbody>
          </table>
          <p class="empty" id="no-results" style="display:none;">Sin resultados para los filtros aplicados.</p>
        </div>
      )}
    </div>
  </main>
</Base>

<script define:vars={{ ultimasJson }}>
  const ALL_DATA = JSON.parse(ultimasJson);

  const COUNTRY_NAMES = { /* ... mismo que antes ... */ };

  // Funciones auxiliares
  function escapeHtml(unsafe) {
    return unsafe
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function copyToClipboard(text, element) {
    navigator.clipboard.writeText(text).then(() => {
      const originalText = element.textContent;
      element.textContent = '✓ Copiado';
      element.style.color = '#10b981';
      
      setTimeout(() => {
        element.textContent = originalText;
        element.style.color = '';
      }, 1800);
    });
  }

  // Renderizado de tabla (igual que antes pero mejorado)
  const fDesde = document.getElementById('f-desde');
  const fHasta = document.getElementById('f-hasta');
  const fIp = document.getElementById('f-ip');
  const fBot = document.getElementById('f-bot');
  const fLimit = document.getElementById('f-limit');
  const btnReset = document.getElementById('btn-reset');
  const tbody = document.getElementById('visitas-body');
  const noResults = document.getElementById('no-results');
  const countEl = document.getElementById('results-count');

  function formatDate(str) {
    if (!str) return '—';
    return new Date(str).toLocaleDateString('es-ES', {
      month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
    });
  }

  function render() {
    if (!tbody) return;

    const desde = fDesde.value ? new Date(fDesde.value + 'T00:00:00') : null;
    const hasta = fHasta.value ? new Date(fHasta.value + 'T23:59:59') : null;
    const ipFilter = fIp.value.trim().toLowerCase();
    const botFilter = fBot.value;
    const limit = parseInt(fLimit.value, 10);

    const filtered = ALL_DATA.filter(v => {
      if (desde || hasta) {
        const d = new Date(v.viewed_at);
        if (desde && d < desde) return false;
        if (hasta && d > hasta) return false;
      }
      if (ipFilter && !(v.ip ?? '').toLowerCase().includes(ipFilter)) return false;
      if (botFilter === '0' && v.is_bot !== 0) return false;
      if (botFilter === '1' && v.is_bot !== 1) return false;
      return true;
    });

    const total = filtered.length;
    const shown = limit > 0 ? filtered.slice(0, limit) : filtered;

    tbody.innerHTML = shown.map(v => {
      const country = v.country ? (COUNTRY_NAMES[v.country] ?? v.country) : '—';
      const city = v.city ?? '—';
      const ipVal = v.ip ?? '—';
      const date = formatDate(v.viewed_at);
      const botBadge = v.is_bot ? `<span class="badge-bot">bot</span>` : '—';

      return `<tr>
        <td class="td-slug" title="${escapeHtml(v.slug)}" onclick="copyToClipboard('${escapeHtml(v.slug)}', this)">${escapeHtml(v.slug)}</td>
        <td>${country}</td>
        <td>${city}</td>
        <td class="td-ip" title="${ipVal}" onclick="copyToClipboard('${ipVal}', this)">${ipVal}</td>
        <td class="td-date">${date}</td>
        <td>${botBadge}</td>
      </tr>`;
    }).join('');

    if (countEl) {
      countEl.textContent = (limit > 0 && total > limit)
        ? `Mostrando ${shown.length} de ${total}`
        : `${total} resultado${total !== 1 ? 's' : ''}`;
    }

    if (noResults) noResults.style.display = shown.length === 0 ? '' : 'none';
  }

  // Event listeners
  [fDesde, fHasta, fIp, fBot, fLimit].forEach(el => {
    el.addEventListener('input', render);
    el.addEventListener('change', render);
  });

  btnReset.addEventListener('click', () => {
    fDesde.value = '';
    fHasta.value = '';
    fIp.value = '';
    fBot.value = '';
    fLimit.value = '20';
    render();
  });

  render();
</script>

<style>
  /* ... (mantengo tus estilos anteriores y añado los nuevos) */

  .table-wrap {
    overflow-x: auto;
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  table {
    table-layout: fixed;
    width: 100%;
    min-width: 880px;
  }

  th:nth-child(1), td:nth-child(1) { width: 29%; }   /* Post */
  th:nth-child(2), td:nth-child(2) { width: 10%; }   /* País */
  th:nth-child(3), td:nth-child(3) { width: 12%; }   /* Ciudad */
  th:nth-child(4), td:nth-child(4) { width: 16%; }   /* IP */
  th:nth-child(5), td:nth-child(5) { width: 19%; }   /* Fecha */
  th:nth-child(6), td:nth-child(6) { width: 6%;  }   /* Bot */

  .td-slug, .td-ip {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
    position: relative;
  }

  .td-slug { font-size: 0.9rem; }
  .td-ip { 
    font-family: monospace; 
    font-size: 0.82rem; 
    color: var(--color-muted);
  }

  tr:hover td {
    background: #f9f9f7;
  }

  .td-date { white-space: nowrap; color: var(--color-muted); }

  /* Tooltip */
  .td-slug:hover::after,
  .td-ip:hover::after {
    content: attr(title);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: #1f1f1f;
    color: #fff;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 0.78rem;
    white-space: nowrap;
    z-index: 20;
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.4);
    pointer-events: none;
  }
</style>